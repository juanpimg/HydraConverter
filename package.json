{
  "name": "hydra-convert",
  "private": true,
  "version": "1.0.2",
  "description": "HydraConvert — conversor de vídeo, audio e imagen 100% local en el navegador (WebCodecs, sin backend)",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test": "node scripts/test-convert.mjs",
    "test:video": "node scripts/test-video-matrix.mjs",
    "test:firefox": "node scripts/test-firefox-convert.mjs",
    "test:cancel-zip": "node scripts/test-cancel-and-zip.mjs",
    "test:audit": "node scripts/test-audit.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "mp4-muxer": "^5.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "webm-muxer": "^5.1.4",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "puppeteer-core": "^24.43.1",
    "tailwindcss": "^3.4.17",
